generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Experiment {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  runs        Run[]
}

model Run {
  id            String    @id @default(uuid())
  experimentId  String
  scenarioId    String?
  idsProfileId  String?
  status        RunStatus @default(QUEUED)
  startedAt     DateTime?
  finishedAt    DateTime?
  /// Whether the exploit landed. Separate from `detected` on purpose: an
  /// attack that fails is still an attack the IDS ought to see.
  attackSuccess Boolean?
  /// Whether the IDS raised a matching alert during the run.
  detected      Boolean?
  /// A run with no attack, used to measure false positives. Without one,
  /// the false-positive rate is not measurable at all.
  isBaseline    Boolean   @default(false)

  // paths to artifacts
  evePath    String?
  msfLogPath String?

  experiment Experiment  @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  scenario   Scenario?   @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  idsProfile IdsProfile? @relation(fields: [idsProfileId], references: [id], onDelete: SetNull)

  attackEvents AttackEvent[]
  alerts       Alert[]
  metrics      Metric?
}

model Alert {
  id        String   @id @default(uuid())
  runId     String
  timestamp DateTime
  signature String
  severity  Int
  srcIp     String
  destIp    String
  raw       Json
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
}

/// One run contributes one cell of a confusion matrix. Precision, recall and
/// F1 are not stored here — over a single run they can only ever be 0 or 1.
/// They are computed across an experiment; see `ExperimentsService`.
model Metric {
  id    String @id @default(uuid())
  runId String @unique

  tp Int @default(0)
  fp Int @default(0)
  fn Int @default(0)
  tn Int @default(0)

  /// Milliseconds from the start of the attack to the first matching alert.
  latencyMs Int?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Scenario {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  msfModule          String
  payload            String?
  rport              Int?
  /// Signatures that count as a detection for this scenario. Empty means any
  /// alert during the run counts.
  expectedSignatures String[] @default([])
  createdAt          DateTime @default(now())

  runs Run[]
}

model IdsProfile {
  id        String   @id @default(uuid())
  name      String   @unique
  /// Identifier of the Suricata ruleset this profile enables.
  ruleset   String
  createdAt DateTime @default(now())

  runs Run[]
}

model AttackEvent {
  id        String   @id @default(uuid())
  runId     String
  /// attack_start | attack_end | attack_success | attack_fail | error
  type      String
  timestamp DateTime @default(now())
  data      Json?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
}

enum RunStatus {
  QUEUED
  RUNNING
  FINISHED
  FAILED
}
