# ─── Database ──────────────────────────────────────────────────────────────────
# The password must match POSTGRES_PASSWORD the database was created with.
DATABASE_URL="postgresql://ids:CHANGE_ME@localhost:5432/ids?schema=public"

# ─── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Authentication ────────────────────────────────────────────────────────────
# Required. The application refuses to start without it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Credentials for the account created by `npm run prisma:seed`.
# Required only when seeding.
SEED_ADMIN_EMAIL=admin@ids.local
SEED_ADMIN_PASSWORD=replace-me-before-seeding

# ─── Queue ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── HTTP ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Swagger UI at /docs. Defaults to off when NODE_ENV=production.
SWAGGER_ENABLED=true

# ─── Lab ───────────────────────────────────────────────────────────────────────
# Containers the runner drives. They come up with docker-compose.yml.
LAB_ATTACKER_CONTAINER=ids_attacker
LAB_VICTIM_HOST=victim

# Where Suricata writes eve.json, as seen by the runner.
EVE_JSON_PATH=./artifacts/suricata/eve.json
